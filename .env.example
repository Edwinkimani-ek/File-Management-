# ---------------------------------------------------------------- Supabase
# Two projects: one for staging, one for production. Never point a staging
# deployment at the production keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses row-level security, so it never goes near the
# browser bundle. Used for firm signup, invitation redemption and the
# scheduled reminder job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------ App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------------- AI
# Kimi API (OpenAI-compatible). Server-side only.
KIMI_API_KEY=
# Optional overrides:
# KIMI_BASE_URL=https://api.kimi.com
# KIMI_MODEL=kimi-latest

# ---------------------------------------------------------------- Email
# Invitations, password resets and diary reminders. Leave RESEND_API_KEY
# unset in local development and the app logs the email instead of sending.
RESEND_API_KEY=
MAIL_FROM=Wakili <onboarding@resend.dev>

# --------------------------------------------------------------- Cron
# Shared secret for /api/cron/*. Vercel Cron sends it automatically as a
# Bearer token when CRON_SECRET is set in the project.
CRON_SECRET=generate-a-long-random-string
